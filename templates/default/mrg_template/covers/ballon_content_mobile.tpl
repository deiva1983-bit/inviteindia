	<div class="balloon">
		{foreach from=$glb_male_arr key=k item=v}
		   <div><span>{$v}</span></div>
		{/foreach}
	</div>
	<h1>Weds</h1>
</div>
	<div class="feballoon">
		{foreach from=$glb_female_arr key=k item=v}
		   <div><span>{$v}</span></div>
		{/foreach}
	</div>

