RewriteRule ^surl/(.*)$ surl/index.php?surl=$1 [L,QSA]
RewriteRule ^online-wedding-website-contactus$ contact_us.php
RewriteRule ^online-wedding-website-aboutus$ aboutus.php
RewriteRule ^answer-add/(.*)$ add_answer.php 

RewriteRule ^my-profile/(.*)$ myprofile.php 
RewriteRule ^forum/(.*)/(.*)$ forum.php?action=$1&forumid=$2
RewriteRule ^forum/(.*)$ forum.php?action=$1
RewriteRule ^(forum/*)$ forum.php
RewriteRule ^wedding-gift-for-couples$ wedding-gift.php
RewriteRule ^gift-collections$ gift.php
RewriteRule ^special-offers-for-your-wedding-gift$ gift-offers.php?offer=dotd

RewriteRule ^view-answers/(.*)/(.*)$ view_answers.php?quesid=$1&quesname=$2

